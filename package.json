{
  "name": "pi-shepherd",
  "version": "0.1.0",
  "description": "Line count guard and behavior rules extension for pi-coding-agent",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "lint": "biome check lib tests index.ts tool-hooks.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-atelier/shared-utils": "github:catlain/pi-shared-utils",
    "ignore": "^7.0.5"
  },
