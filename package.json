  "bundleDependencies": [
    "@pi-atelier/shared-utils"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.0.0"
  },
  "files": [
    "index.ts",
    "shepherd/",
